@echo off&color 4f
setlocal EnableExtensions EnableDelayedExpansion
set "tl=反恐精英 CS 1.6"
title %tl%
mode con: lines=36 cols=96 >nul 2>&1
if exist "%~dp0_tools\nircmd\nircmdc.exe" "%~dp0_tools\nircmd\nircmdc.exe" win center ititle "%tl%"
cd /d "%~dp0"
if /i "%~1"=="/server" (
  set "sv=%~2"
  if not defined sv set "sv=1"
  if not "!sv!"=="1" if not "!sv!"=="2" if not "!sv!"=="3" if not "!sv!"=="4" if not "!sv!"=="5" set "sv=1"
  if exist "game_starter.exe" (
    start "" "%~dp0game_starter.exe" /server !sv!
    exit /b 0
  )
  >"cstrike\server_preset.cfg" echo // generated by game_starter.bat
  >>"cstrike\server_preset.cfg" echo exec server.cfg
  >>"cstrike\server_preset.cfg" echo bot_join_after_player 0
  >>"cstrike\server_preset.cfg" echo bot_quota 8
  >>"cstrike\server_preset.cfg" echo bot_difficulty 2
  >>"cstrike\server_preset.cfg" echo bot_prefix "[BOT]"
  (
    echo ==================================================
    echo    反恐精英 1.6 专用服务器已启动
    echo    配置：混战 · 16 人 · de_dust2 · 8 个机器人
    echo    局域网玩家：游戏里 寻找服务器 → 局域网
    echo ==================================================
    echo.
  ) >>"cstrike\server_preset.cfg"
  start "CS 1.6 专用服务器 · 混战 · de_dust2 · 16人" "%~dp0hlds.exe" -game cstrike -console -insecure +sv_lan 1 +maxplayers 16 +map de_dust2 -port 27015 +servercfgfile server_preset.cfg
  exit /b 0
)
:: 控制台版启动器：选项、顺序、默认值与 game_starter.exe 一致，自己启动游戏，不转发 GUI
:: 平台零交互入口：game_starter.bat /go（等价于「1 正常游玩」直接启动）
if not exist "opengl32.dll" if exist "_mesa\opengl32.dll" copy /y "_mesa\opengl32.dll" "opengl32.dll" >nul
if not exist "libgallium_wgl.dll" if exist "_mesa\libgallium_wgl.dll" copy /y "_mesa\libgallium_wgl.dll" "libgallium_wgl.dll" >nul
if not exist "dxil.dll" if exist "_mesa\dxil.dll" copy /y "_mesa\dxil.dll" "dxil.dll" >nul
if not exist "opengl32.dll" (
  echo.
  echo   缺少兼容文件，请先双击 兼容修复.bat
  if /i not "%~1"=="/go" pause
  exit /b 1
)
if not exist "libgallium_wgl.dll" (
  echo.
  echo   缺少兼容文件，请先双击 兼容修复.bat
  if /i not "%~1"=="/go" pause
  exit /b 1
)
if not exist "dxil.dll" (
  echo.
  echo   缺少兼容文件，请先双击 兼容修复.bat
  if /i not "%~1"=="/go" pause
  exit /b 1
)
set "sel=1"
if /i not "%~1"=="/go" (
  cls
  echo.
  echo   ============================================================
  echo     反恐精英 Counter-Strike 1.6
  echo     Valve · GoldSrc 2003 · 简体中文硬盘版
  echo   ------------------------------------------------------------
  echo     经典战术射击：警匪对抗、买枪、打点位。单机带机器人。
  echo.
  echo     操作：W A S D 移动 / 鼠标 视角·射击 / R 换弹 / B 买枪
  echo.
  echo     一键买枪（小键盘，买枪时间内，出生点附近）
  echo       7 沙鹰   8 M249   9 连狙
  echo       4 Famas  5 AUG    6 AWP
  echo       1 手雷   2 闪光   3 烟雾
  echo       . 弹药   回车 甲+盔   0 买满弹药
  echo       B 购买菜单   , / . 买子弹   H 服务器设置
  echo   ------------------------------------------------------------
  echo     画面 / 分辨率
  echo       1  1920×1080 全屏（默认）
  echo       2  1920×1080 窗口
  echo       3  1600×900 全屏
  echo       4  1280×720 全屏
  echo       5  1024×768 全屏
  echo.
  echo       6  打开运行日志
  echo       7  退出
  echo       8  启动专用服务器（局域网联机，选一个模板）
  echo.
  echo     注意：一般玩直接选 1-5 启动游戏，游戏里也能创建服务器；
  echo           8 是专用服务器，给专门开服的场景用，模板已配好，
  echo           一般直接用游戏端就行。
  echo   ============================================================
  echo.
  set /p "sel=  请选择 [1-8]，直接回车 = 1: "
)
if not defined sel set "sel=1"
set "sel=%sel: =%"
if not "%sel%"=="1" if not "%sel%"=="2" if not "%sel%"=="3" if not "%sel%"=="4" if not "%sel%"=="5" if not "%sel%"=="6" if not "%sel%"=="7" if not "%sel%"=="8" set "sel=1"
if "%sel%"=="6" (
  if exist "运行日志.txt" start "" notepad "%~dp0运行日志.txt"
  exit /b 0
)
if "%sel%"=="7" exit /b 0
if "%sel%"=="8" (
  if not exist "hlds.exe" (
    echo.
    echo   找不到 hlds.exe
    pause
    exit /b 1
  )
  echo.
  echo   专用服务器 · 选一个模板直接开服（专门开服场景用；一般玩直接用游戏端）
  echo     1  混战 · 16 人 · de_dust2 · 8 个机器人（默认）
  echo     2  比赛 5v5 · 10 人 · de_inferno · 无机器人
  echo     3  练枪 · 16 人 · awp_map · 12 个机器人
  echo     4  娱乐 · 16 人 · fy_iceworld · 8 个机器人
  echo     5  随机地图 · 16 人 · 启动时随机挑图 · 8 个机器人
  echo.
  set "sv=1"
  set /p "sv=  请选择 [1-5]，直接回车 = 1: "
)
if "%sel%"=="8" (
  set "sv=!sv: =!"
  if not defined sv set "sv=1"
  if not "!sv!"=="1" if not "!sv!"=="2" if not "!sv!"=="3" if not "!sv!"=="4" if not "!sv!"=="5" set "sv=1"
  set "SVP_NAME=混战"
  set "SVP_MAX=16"
  set "SVP_MAP=de_dust2"
  set "SVP_BOTS=8"
  if "!sv!"=="2" (
    set "SVP_NAME=比赛 5v5"
    set "SVP_MAX=10"
    set "SVP_MAP=de_inferno"
    set "SVP_BOTS=0"
  )
  if "!sv!"=="3" (
    set "SVP_NAME=练枪"
    set "SVP_MAP=awp_map"
    set "SVP_BOTS=12"
  )
  if "!sv!"=="4" (
    set "SVP_NAME=娱乐刀战"
    set "SVP_MAP=fy_iceworld"
  )
  if "!sv!"=="5" (
    set "SVP_NAME=随机地图"
    set /a SVP_RND=%random% %% 10
    if !SVP_RND!==0 set "SVP_MAP=de_dust2"
    if !SVP_RND!==1 set "SVP_MAP=de_inferno"
    if !SVP_RND!==2 set "SVP_MAP=de_nuke"
    if !SVP_RND!==3 set "SVP_MAP=de_train"
    if !SVP_RND!==4 set "SVP_MAP=de_aztec"
    if !SVP_RND!==5 set "SVP_MAP=cs_italy"
    if !SVP_RND!==6 set "SVP_MAP=cs_assault"
    if !SVP_RND!==7 set "SVP_MAP=de_cbble"
    if !SVP_RND!==8 set "SVP_MAP=de_prodigy"
    if !SVP_RND!==9 set "SVP_MAP=de_dust"
  )
  set "SVP_BOTSTEXT=!SVP_BOTS! 个机器人"
  if "!SVP_BOTS!"=="0" set "SVP_BOTSTEXT=无机器人"
  if "!SVP_BOTS!"=="0" (
    >"cstrike\server_preset.cfg" echo // generated by game_starter.bat
    >>"cstrike\server_preset.cfg" echo exec server.cfg
    >>"cstrike\server_preset.cfg" echo bot_quota 0
    >>"cstrike\server_preset.cfg" echo bot_kick all
  ) else (
    >"cstrike\server_preset.cfg" echo // generated by game_starter.bat
    >>"cstrike\server_preset.cfg" echo exec server.cfg
    >>"cstrike\server_preset.cfg" echo bot_join_after_player 0
    >>"cstrike\server_preset.cfg" echo bot_quota !SVP_BOTS!
    >>"cstrike\server_preset.cfg" echo bot_difficulty 2
    >>"cstrike\server_preset.cfg" echo bot_prefix "[BOT]"
  )
  (
    echo ==================================================
    echo    反恐精英 1.6 专用服务器已启动
    echo    配置：!SVP_NAME! · !SVP_MAX! 人 · !SVP_MAP! · !SVP_BOTSTEXT!
    echo    局域网玩家：游戏里 寻找服务器 → 局域网
    echo ==================================================
    echo.
  ) >>"cstrike\server_preset.cfg"
  echo.
  echo   正在开服：!SVP_NAME! · !SVP_MAX! 人 · !SVP_MAP!
  if exist "game_starter.exe" (
    start "" "%~dp0game_starter.exe" /server !sv!
    exit /b 0
  )
  start "CS 1.6 专用服务器 · !SVP_NAME! · !SVP_MAP! · !SVP_MAX!人" "%~dp0hlds.exe" -game cstrike -console -insecure +sv_lan 1 +maxplayers !SVP_MAX! +map !SVP_MAP! -port 27015 +servercfgfile server_preset.cfg
  exit /b 0
)
set "RES_W=1920"
set "RES_H=1080"
set "WINMODE=0"
if "%sel%"=="2" (
  set "WINMODE=1"
)
if "%sel%"=="3" (
  set "RES_W=1600"
  set "RES_H=900"
)
if "%sel%"=="4" (
  set "RES_W=1280"
  set "RES_H=720"
)
if "%sel%"=="5" (
  set "RES_W=1024"
  set "RES_H=768"
)
reg add "HKCU\Software\Valve\Half-Life\Settings" /v EngineDLL /t REG_SZ /d "hw.dll" /f >nul
reg add "HKCU\Software\Valve\Half-Life\Settings" /v ScreenWidth /t REG_DWORD /d %RES_W% /f >nul
reg add "HKCU\Software\Valve\Half-Life\Settings" /v ScreenHeight /t REG_DWORD /d %RES_H% /f >nul
reg add "HKCU\Software\Valve\Half-Life\Settings" /v ScreenBPP /t REG_DWORD /d 32 /f >nul
reg add "HKCU\Software\Valve\Half-Life\Settings" /v ScreenWindowed /t REG_DWORD /d %WINMODE% /f >nul
reg add "HKCU\Software\Valve\Half-Life\Settings" /v CrashInitializingVideoMode /t REG_DWORD /d 0 /f >nul
reg add "HKCU\Software\Valve\Steam" /v Language /t REG_SZ /d "schinese" /f >nul
if not exist "cstrike_schinese\usercfg_name.cfg" (
  >"cstrike_schinese\usercfg_name.cfg" echo name "YunGamer-%COMPUTERNAME%"
)
if not exist "cstrike\usercfg_name.cfg" (
  >"cstrike\usercfg_name.cfg" echo name "YunGamer-%COMPUTERNAME%"
)
if exist "CSOverlay.exe" start "" "%~dp0CSOverlay.exe" cstrike bots
set "args=-game cstrike"
if "%WINMODE%"=="1" set "args=-game cstrike -window"
echo.
echo   正在启动游戏，退出后本窗口自动关闭
echo.
"%~dp0cstrike.exe" !args! >nul 2>&1
set "rc=%ERRORLEVEL%"
exit /b %rc%
